; GoldBasketGuard preset - XAUUSD, 2 decimals - grid / averaging basket
; grid / averaging basket: levels glued to the basket average, risk-sized SL (3%),
; risk-free on the average after 150p with 30% volume cut, money target/stop, news closes everything, 35% breaker, 8% daily limit.
; Load: EA properties dialog -> button [Presets] -> Load -> choose this file.
; Every value is documented in docs/GoldBasketGuard-parameters.md
InpMagicFilter=0
InpOnlyThisChartSymbol=true
InpIncludeBuy=true
InpIncludeSell=true
InpOnlyAfterAttach=false
InpApplyMode=1
InpSLPips=450.0
InpTPPips=250.0
InpOverwriteExisting=true
InpAutoApplyToNew=true
InpAutoApplyOnStart=true
InpReapplyEveryCycle=true
InpAbsSLPrice=0.0
InpAbsTPPrice=0.0
InpMirrorSL=true
InpMirrorTP=true
InpMirrorMode=1
InpMirrorGuardSec=4
InpBeMode=2
InpBeTriggerPips=150.0
InpBeLockPips=8.0
InpBeLevel=1
InpBeOnlyIfProfitable=true
InpBeOneShot=false
InpBeClosePartial=true
InpBeClosePartialPct=30.0
InpBeUseHardTpInstead=false
InpTrailMode=3
InpTrailStartPips=200.0
InpTrailStepPips=30.0
InpTrailMinPips=40.0
InpTrailFollowGroup=true
InpTrailMoveTpToo=false
InpEnableBasketMoneyExit=true
InpEstCommissionPerLot=7.0
InpEnableKillSwitch=true
InpMaxDrawdownPctEquity=15.0
InpCloseAllOnKill=true
InpPipSize=0.1
InpMinStopsPoints=10
InpMinDeltaPoints=2
InpDeviationPoints=30
InpMaxModsPerSecond=4
InpMinSecPerTicket=2
InpRetryCount=3
InpRetryDelayMs=350
InpRequireNewBar=false
InpTimerSeconds=1
InpDryRun=false
InpNewsEnabled=true
InpNewsImportance=3
InpNewsIncludeModerate=false
InpNewsBeforeMin=30
InpNewsAfterMin=15
InpNewsCurrencies=USD
InpNewsAction=4
InpNewsPauseAutomation=true
InpNewsTightenBeforeClose=true
InpNewsManualWindows=
InpNewsRefreshSec=30
InpRiskPctPerBasket=3.0
InpRiskRewardRatio=0.0
InpRiskCapPips=600.0
InpRiskFloorPips=80.0
InpEmergencyFloatLossPct=35
InpEmergencyEquityDdPct=0.0
InpEmergencyMarginLevelPct=150
InpEmergencyFreeMarginPct=0
InpEmergencyStepDown=false
InpEmergencyLockHours=24
InpDailyLossLimitPct=8.0
InpDailyProfitTargetPct=0.0
InpDailyCloseOnLimit=true
InpMoneyBasis=0
InpCentDivisor=100.0
InpAdaptiveStops=true
InpAdaptiveStopsCapPoints=300
InpShowPanel=true
InpAlertOnRiskFree=true
InpVerboseLog=true
