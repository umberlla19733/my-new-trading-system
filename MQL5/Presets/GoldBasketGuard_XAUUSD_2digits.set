; GoldBasketGuard preset - XAUUSD with 2 decimal places (most common gold quote)
; Load in MT5: Experts list -> right click -> Properties -> Common tab is not enough:
; use the "Presets" button in the EA dialog -> Load. Values are also listed in docs/.
;--- group ---
InpMagicFilter=0
InpOnlyThisChartSymbol=true
InpIncludeBuy=true
InpIncludeSell=true
InpOnlyAfterAttach=false
;--- group TP / SL ---
InpApplyMode=1
InpSLPips=300.0
InpTPPips=500.0
InpOverwriteExisting=true
InpAutoApplyToNew=true
InpAutoApplyOnStart=true
InpReapplyEveryCycle=false
InpAbsSLPrice=0.0
InpAbsTPPrice=0.0
;--- mirror one edit to all ---
InpMirrorSL=true
InpMirrorTP=true
InpMirrorMode=1
InpMirrorGuardSec=4
;--- risk free ---
InpBeMode=2
InpBeTriggerPips=200.0
InpBeLockPips=10.0
InpBeLevel=0
InpBeOnlyIfProfitable=true
InpBeOneShot=true
InpBeClosePartial=false
InpBeClosePartialPct=30.0
InpBeUseHardTpInstead=false
;--- trailing ---
InpTrailMode=1
InpTrailStartPips=250.0
InpTrailStepPips=30.0
InpTrailMinPips=40.0
InpTrailFollowGroup=true
InpTrailMoveTpToo=false
;--- money ---
InpEnableBasketMoneyExit=false
InpEstCommissionPerLot=0.0
InpEnableKillSwitch=true
InpMaxDrawdownPctEquity=12.0
InpCloseAllOnKill=true
;--- broker safety (gold) ---
InpPipSize=0.1
InpMinStopsPoints=0
InpMinDeltaPoints=2
InpDeviationPoints=30
InpMaxModsPerSecond=4
InpMinSecPerTicket=2
InpRetryCount=3
InpRetryDelayMs=350
InpRequireNewBar=false
InpTimerSeconds=1
InpDryRun=false
;--- ui ---
InpShowPanel=true
InpAlertOnRiskFree=true
InpVerboseLog=true
