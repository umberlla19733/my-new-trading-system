; GoldBasketGuard preset - XAUUSD, 2 decimal places (most common gold quote)
; standard gold setup: group SL 300p / TP 500p, risk-free after 200p,
; step trailing, red-folder news guard (close group), breaker at 50% of balance.
; Load: EA properties dialog -> button [Presets] -> Load -> choose this file.
; Every value is documented in docs/GoldBasketGuard-parameters.md
InpMagicFilter=0
InpOnlyThisChartSymbol=true
InpIncludeBuy=true
InpIncludeSell=true
InpOnlyAfterAttach=false
InpApplyMode=1
InpSLPips=300.0
InpTPPips=500.0
InpOverwriteExisting=true
InpAutoApplyToNew=true
InpAutoApplyOnStart=true
InpReapplyEveryCycle=false
InpAbsSLPrice=0.0
InpAbsTPPrice=0.0
InpMirrorSL=true
InpMirrorTP=true
InpMirrorMode=1
InpMirrorGuardSec=4
InpBeMode=2
InpBeTriggerPips=200.0
InpBeLockPips=10.0
InpBeLevel=0
InpBeOnlyIfProfitable=true
InpBeOneShot=true
InpBeClosePartial=false
InpBeClosePartialPct=30.0
InpBeUseHardTpInstead=false
InpTrailMode=1
InpTrailStartPips=250.0
InpTrailStepPips=30.0
InpTrailMinPips=40.0
InpTrailFollowGroup=true
InpTrailMoveTpToo=false
InpEnableBasketMoneyExit=false
InpEstCommissionPerLot=0.0
InpEnableKillSwitch=true
InpMaxDrawdownPctEquity=12.0
InpCloseAllOnKill=true
InpPipSize=0.1
InpMinStopsPoints=0
InpMinDeltaPoints=2
InpDeviationPoints=30
InpMaxModsPerSecond=4
InpMinSecPerTicket=2
InpRetryCount=3
InpRetryDelayMs=350
InpRequireNewBar=false
InpTimerSeconds=1
InpDryRun=false
InpNewsEnabled=true
InpNewsImportance=3
InpNewsIncludeModerate=false
InpNewsBeforeMin=20
InpNewsAfterMin=15
InpNewsCurrencies=USD
InpNewsAction=3
InpNewsPauseAutomation=true
InpNewsTightenBeforeClose=true
InpNewsManualWindows=
InpNewsRefreshSec=30
InpRiskPctPerBasket=0.0
InpRiskRewardRatio=0.0
InpRiskCapPips=0.0
InpRiskFloorPips=80.0
InpEmergencyFloatLossPct=50
InpEmergencyEquityDdPct=0.0
InpEmergencyMarginLevelPct=150
InpEmergencyFreeMarginPct=0
InpEmergencyStepDown=false
InpEmergencyLockHours=24
InpDailyLossLimitPct=0.0
InpDailyProfitTargetPct=0.0
InpDailyCloseOnLimit=true
InpMoneyBasis=0
InpCentDivisor=100.0
InpAdaptiveStops=true
InpAdaptiveStopsCapPoints=300
InpShowPanel=true
InpAlertOnRiskFree=true
InpVerboseLog=true
